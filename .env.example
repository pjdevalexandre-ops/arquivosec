# ==============================================================================
# ArquivoSec - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local em ambiente de desenvolvimento
# ou configure no painel da Vercel para ambiente de produção.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados Postgres + Autenticação + RLS)
# Obtenha em: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 (Armazenamento de Arquivos S3-Compatible)
# Obtenha em: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# ------------------------------------------------------------------------------
# ID da Conta Cloudflare (encontrado na barra lateral da Cloudflare ou URL do painel R2)
R2_ACCOUNT_ID=sua_account_id_cloudflare

# Chave de Acesso R2 (Access Key ID gerada para o token com permissões de Leitura/Escrita)
R2_ACCESS_KEY_ID=sua_r2_access_key_id

# Segredo da Chave de Acesso R2
R2_SECRET_ACCESS_KEY=seu_r2_secret_access_key

# Nome do Bucket Privado criado no R2
R2_BUCKET_NAME=arquivosec-documentos

# Endpoint S3 do R2: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# O sistema calcula automaticamente se omitido, mas pode ser explicitado:
R2_ENDPOINT=https://sua_account_id_cloudflare.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 3. APLICAÇÃO E SEGURANÇA
# ------------------------------------------------------------------------------
# URL pública da aplicação (ex: http://localhost:3000 ou https://arquivosec.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave secreta interna para criptografia de tokens de compartilhamento e hashes
APP_SECRET=gere_uma_chave_secreta_aleatoria_com_openssl_rand_hex_32

# Cota padrão por gestor em bytes (Padrão: 250 GB = 268435456000 bytes)
DEFAULT_STORAGE_LIMIT_BYTES=268435456000
